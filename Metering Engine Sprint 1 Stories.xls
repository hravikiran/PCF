   <Column ss:Width="56"/>
   <Row ss:Height="28"><Cell ss:MergeAcross="10" ss:StyleID="sTitle"><Data ss:Type="String">Metering Engine  —  Sprint 1 Stories</Data></Cell></Row>
   <Row ss:Height="20"><Cell ss:MergeAcross="10" ss:StyleID="sSub"><Data ss:Type="String">10-day sprint  ·  Jul 29 – Aug 11, 2026 (weekends excluded)  ·  5 parallel tracks  ·  fill the Owner column to assign per team member</Data></Cell></Row>
   <Row ss:Height="30">
    <Cell ss:StyleID="sHead"><Data ss:Type="String">ID</Data></Cell>
    <Cell ss:StyleID="sHead"><Data ss:Type="String">Component</Data></Cell>
    <Cell ss:StyleID="sHead"><Data ss:Type="String">Track</Data></Cell>
    <Cell ss:StyleID="sHead"><Data ss:Type="String">Story</Data></Cell>
    <Cell ss:StyleID="sHead"><Data ss:Type="String">Description</Data></Cell>
    <Cell ss:StyleID="sHead"><Data ss:Type="String">Est (d)</Data></Cell>
    <Cell ss:StyleID="sHead"><Data ss:Type="String">Owner</Data></Cell>
    <Cell ss:StyleID="sHead"><Data ss:Type="String">Start</Data></Cell>
    <Cell ss:StyleID="sHead"><Data ss:Type="String">End</Data></Cell>
    <Cell ss:StyleID="sHead"><Data ss:Type="String">Depends on</Data></Cell>
    <Cell ss:StyleID="sHead"><Data ss:Type="String">Status</Data></Cell>
   </Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="sPlat"><Data ss:Type="String">Platform</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Foundation</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Repo, branch strategy &amp; CI/CD pipelines</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Create/configure EP, Aggregator, ME repos; branch strategy; CI build + test pipelines; dev environment.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 29</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 30</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">P2</Data></Cell><Cell ss:StyleID="sPlat"><Data ss:Type="String">Platform</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Foundation</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Shared event model &amp; common libraries</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Canonical billing-event model, serialization, config &amp; logging libs shared across components.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 31</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 3</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">P3</Data></Cell><Cell ss:StyleID="sPlat"><Data ss:Type="String">Platform</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Data</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Mongo schema finalization &amp; creation</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Finalize billable / non_billable / rejected collections + master collection; create schemas.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 4</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 5</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">P2</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">P4</Data></Cell><Cell ss:StyleID="sPlat"><Data ss:Type="String">Platform</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Data</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Identify &amp; apply Mongo indexes</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Query patterns per component; define &amp; apply indexes (eventId, aggregator, period, status).</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">1</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 6</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 6</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">P3</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">S1</Data></Cell><Cell ss:StyleID="sSim"><Data ss:Type="String">Simulator</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Simulator</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Publish sample success billing events to Kafka</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Simulator publishes valid success billing events onto the Kafka topic; configurable count.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 29</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 30</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">S2</Data></Cell><Cell ss:StyleID="sSim"><Data ss:Type="String">Simulator</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Simulator</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Publish negative / edge sample events</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Missing mandatory fields, bad date format, unknown aggregator/cluster — for validation tests.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 31</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 3</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">S1</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">S3</Data></Cell><Cell ss:StyleID="sSim"><Data ss:Type="String">Simulator</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Simulator</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Consume from Kafka → write RAW_EVENTS to HPOS</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Simulator consumer that reads the topic and writes raw events to the HPOS RAW_EVENTS bucket.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 4</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 5</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">S1</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">S4</Data></Cell><Cell ss:StyleID="sSim"><Data ss:Type="String">Simulator</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Simulator</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Master-data seeder</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Seed bank details &amp; mapping master data for enrichment / validation tests.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">1</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 6</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 6</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">P3</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">S5</Data></Cell><Cell ss:StyleID="sSim"><Data ss:Type="String">Simulator</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Simulator</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Late-arrival &amp; duplicate-eventId generator</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Emit events with past event-time windows and duplicate eventIds for idempotency/replay tests.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 7</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 10</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">S1</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">E1</Data></Cell><Cell ss:StyleID="sEP"><Data ss:Type="String">Event Processor</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">EP</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Kafka consumer + Consumer Group config</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Consumer wiring, single consumer group, partition ownership, config.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 29</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 30</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">E2</Data></Cell><Cell ss:StyleID="sEP"><Data ss:Type="String">Event Processor</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">EP</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">HPOS client — batch insert primitive</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Reusable HPOS write primitive (batched PUT) with deterministic keys.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 31</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 3</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">E1</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">E3</Data></Cell><Cell ss:StyleID="sEP"><Data ss:Type="String">Event Processor</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">EP</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">HPOS client — batch retrieve &amp; delete primitives</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">List/GET by prefix + batch delete primitives (shared with Aggregator).</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 4</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 5</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">E2</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">E4</Data></Cell><Cell ss:StyleID="sEP"><Data ss:Type="String">Event Processor</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">EP</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Direct-to-HPOS write of RAW_EVENTS</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Consume → write raw event as-is to HPOS, deterministic key by eventId.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 6</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 7</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">E2</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">E5</Data></Cell><Cell ss:StyleID="sEP"><Data ss:Type="String">Event Processor</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">EP</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Offset commit after successful write</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Commit offset only after HPOS write ack (zero-loss ordering).</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">1</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 10</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 10</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">E4</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">E6</Data></Cell><Cell ss:StyleID="sEP"><Data ss:Type="String">Event Processor</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">EP</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Resiliency spike — pause/resume + backoff</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Circuit-breaker pause/resume on HPOS failure; retry with backoff.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">1</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 11</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aug 11</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">E4</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
   <Row ss:Height="40"><Cell ss:StyleID="sIDcell"><Data ss:Type="String">A1</Data></Cell><Cell ss:StyleID="sAgg"><Data ss:Type="String">Aggregator</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Aggregator</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Scheduler skeleton + grace window config</Data></Cell><Cell ss:StyleID="sBody"><Data ss:Type="String">Interval scheduler with configurable grace window (6h); run bookkeeping.</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="sCtr"/><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 29</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Jul 30</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="sCtr"><Data ss:Type="String">Ready</Data></Cell></Row>
