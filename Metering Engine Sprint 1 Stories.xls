 <Worksheet ss:Name="Sprint 1 Stories">
  <Table ss:DefaultColumnWidth="60" ss:DefaultRowHeight="15">
   <Column ss:Width="34"/>
   <Column ss:Width="82"/>
   <Column ss:Width="64"/>
